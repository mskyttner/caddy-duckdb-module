# Dockerfile for FTS Sidecar Service
#
# This builds the FTS (Full-Text Search) sidecar service using LanceDB.
# The service provides FTS capabilities for the Caddy DuckDB module.
#
# Build:
#   docker build -f Dockerfile.fts -t fts-sidecar .
#
# Run:
#   docker run -p 8701:8701 -v $(pwd)/data:/data fts-sidecar
#
# Environment variables:
#   FTS_PORT       - HTTP port (default: 8701)
#   FTS_INDEX_PATH - Path to Lance indexes (default: /data/fts)
#   FTS_LOG_LEVEL  - Log level: debug, info, warn, error (default: info)

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM golang:1.24-bookworm AS builder

# Install build dependencies for CGO and LanceDB native libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libc6-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download and install LanceDB native libraries
# The lancedb-go package requires native Rust bindings
ENV LANCEDB_DIR=/root/.lancedb
RUN mkdir -p ${LANCEDB_DIR} && \
    curl -fsSL https://raw.githubusercontent.com/lancedb/lancedb-go/main/scripts/download_native.sh -o /tmp/download_native.sh && \
    chmod +x /tmp/download_native.sh && \
    /tmp/download_native.sh || echo "Native library download may have failed - continuing with build"

WORKDIR /build

# Copy go.mod and go.sum first for better layer caching
COPY go.mod go.sum ./

# Add lancedb-go dependency
RUN go get github.com/lancedb/lancedb-go/pkg/lancedb@latest && \
    go mod download

# Copy source code
COPY . .

# Build the FTS sidecar binary with CGO enabled
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-I${LANCEDB_DIR}/include"
ENV CGO_LDFLAGS="-L${LANCEDB_DIR}/lib -llancedb"
RUN go build -ldflags="-s -w" -o fts-sidecar ./cmd/fts-sidecar

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM debian:bookworm-slim

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r fts && useradd -r -g fts fts

# Create directories with correct ownership
RUN mkdir -p /data/fts /app && \
    chown -R fts:fts /data /app

# Copy LanceDB native libraries from builder
COPY --from=builder /root/.lancedb/lib /usr/local/lib/
ENV LD_LIBRARY_PATH=/usr/local/lib

# Update library cache
RUN ldconfig || true

WORKDIR /app

# Copy binary from builder with correct ownership
COPY --from=builder --chown=fts:fts /build/fts-sidecar .

# Labels
LABEL org.opencontainers.image.title="FTS Sidecar Service" \
      org.opencontainers.image.description="Full-text search sidecar for Caddy DuckDB Module using LanceDB" \
      org.opencontainers.image.source="https://github.com/tobilg/caddy-duckdb-module"

# Expose default port
EXPOSE 8701

# Volume for persistent indexes
VOLUME ["/data"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -fsS http://localhost:${FTS_PORT:-8701}/health || exit 1

# Run as non-root user
USER fts

# Default environment
ENV FTS_PORT=8701
ENV FTS_INDEX_PATH=/data/fts
ENV FTS_LOG_LEVEL=info

# Entry point
ENTRYPOINT ["/app/fts-sidecar"]
